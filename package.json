{
  "name": "zustand-inspector",
  "version": "0.1.0",
  "description": "Framework-agnostic Zustand devtools for TanStack Devtools: lossless time travel, action log, diffs, redaction. Apps need no React; an optional panel is built with Meta's Astryx.",
  "type": "module",
  "license": "MIT",
  "author": "Danilo Britto (https://github.com/dbritto-dev)",
  "keywords": [
    "zustand",
    "devtools",
    "tanstack",
    "tanstack-devtools",
    "time-travel",
    "state-management",
    "vanilla"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./panel": {
      "types": "./dist/types/panel/index.d.ts",
      "import": "./dist/panel.js"
    },
    "./astryx": {
      "types": "./dist/types/astryx/index.d.ts",
      "import": "./dist/astryx.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --mode demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p .",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "dependencies": {
    "@tanstack/devtools-event-client": "^0.5.1"
  },
  "peerDependencies": {
    "@tanstack/devtools": ">=0.16.0 <0.17.0",
    "zustand": ">=5.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "@astryxdesign/core": ">=0.7.5 <0.8.0",
    "@astryxdesign/theme-neutral": ">=0.7.5 <0.8.0",
    "@stylexjs/stylex": "^0.19.0",
    "lucide-react": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/devtools": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@astryxdesign/core": {
      "optional": true
    },
    "@astryxdesign/theme-neutral": {
      "optional": true
    },
    "@stylexjs/stylex": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.5",
    "@astryxdesign/core": "^0.7.5",
    "@astryxdesign/theme-neutral": "^0.7.5",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/devtools": "^0.16.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
